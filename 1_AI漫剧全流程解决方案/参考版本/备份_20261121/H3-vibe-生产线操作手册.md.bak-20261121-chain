# N9 装配（推荐 --dual：01 预览 + 02 出片双份，自动校验 segments 一致）
python csv_to_timeline.py --csv shotlist.csv --dual \
  --out out/H3-vibe-EP001-G01.json --seed 42 --input-root "<ComfyUI input>"

# N11 前独立复验两份副本
python csv_to_timeline.py --compare out/H3-vibe-EP001-G01_preview.json out/H3-vibe-EP001-G01_final.json

# 只需单份 02 副本 / 自定义 SaveVideo 前缀（底座默认通用02，--workflow 可省略）
python csv_to_timeline.py --group G02 --out out/H3-vibe-G02.json --save-prefix "video/EP001_G02"

# 只装配某个连续组 / 做真人写实向（仅切换告警口径，不改写内容）
